---
const showNav = Astro.props.showNav ?? true;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="bg-white border-b border-gray-200">
  <!-- FULL WIDTH BAR -->
  <div class="w-full px-4 md:px-6 lg:px-10 xl:px-16">
    <!-- CONTENT WIDTH CONTROL -->
    <div class="max-w-screen-xl mx-auto flex items-center justify-between py-4">
      <!-- Left -->
      <div class="flex items-center gap-8">
        <a href={baseUrl} class="text-xl font-bold text-green-700">
          SmartShop
        </a>

        {
          showNav && (
            <nav class="hidden md:flex gap-6 text-gray-700">
              <a href={baseUrl + "list/"} class="hover:text-green-700">
                New List
              </a>
              <a href={baseUrl + "lists/"} class="hover:text-green-700">
                My Lists
              </a>
              <a href="#" class="hover:text-green-700">
                Help
              </a>
            </nav>
          )
        }
      </div>

      <!-- Right -->
      <div class="flex items-center gap-3">
        <!-- Show when NOT logged in -->
        <a id="loginBtn" href={baseUrl + "login/"} class="btn-primary">
          Log in
        </a>

        <!-- Show when logged in -->
        <a
          id="accountBtn"
          href={baseUrl + "account/"}
          class="btn-primary hidden"
        >
          Account
        </a>

        <button id="logoutBtn" class="btn-secondary hidden"> Log out </button>
      </div>
    </div>
  </div>

  <script type="module" define:vars={{ baseUrl }}>
    const authUrl = baseUrl + "auth.js";

    import(authUrl).then(({ auth }) => {
      import("https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js").then(
        ({ onAuthStateChanged, signOut }) => {
          const loginBtn = document.getElementById("loginBtn");
          const logoutBtn = document.getElementById("logoutBtn");
          const accountBtn = document.getElementById("accountBtn");

          onAuthStateChanged(auth, (user) => {
            if (user) {
              loginBtn.classList.add("hidden");
              accountBtn.classList.remove("hidden");
              logoutBtn.classList.remove("hidden");
            } else {
              loginBtn.classList.remove("hidden");
              accountBtn.classList.add("hidden");
              logoutBtn.classList.add("hidden");
            }
          });

          logoutBtn.addEventListener("click", async () => {
            await signOut(auth);
            window.location.href = baseUrl;
          });
        }
      );
    });
  </script>
</header>
