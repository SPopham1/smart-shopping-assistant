---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout>
  <Header showNav={false} />

  <main class="container flex justify-center py-12">
    <div class="card w-full max-w-md">
      <h2 class="text-2xl font-semibold mb-6 text-center">Log in</h2>

      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Email
          </label>
          <input type="email" required class="input" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Password
          </label>
          <input type="password" required class="input" />
        </div>

        <button type="submit" class="btn-primary w-full"> Log in </button>
      </form>
      <p class="text-sm text-center text-gray-600 mt-4">
        Don't have an account?
        <a href={`${baseUrl}signup/`} class="text-green-700 font-medium hover:underline">
          Sign up
        </a>
      </p>
    </div>
  </main>
  
  <script type="module" define:vars={{ baseUrl }}>
    import { login } from `${baseUrl}auth.js`;
    import { onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
    import { auth } from `${baseUrl}firebase.js`;

    const form = document.querySelector("form");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = form.querySelector('input[type="email"]').value;
      const password = form.querySelector('input[type="password"]').value;

      try {
        await login(email, password);
        window.location.href = baseUrl;
      } catch (err) {
        alert(err.message);
        console.error(err);
      }
    });

    onAuthStateChanged(auth, (user) => {
      if (user) {
        window.location.href = baseUrl;
      }
    });
  </script>
</BaseLayout>