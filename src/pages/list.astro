---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout>
  <Header />

  <main class="container py-12">
    <div class="max-w-4xl mx-auto">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">My Shopping List</h1>
        <a href={baseUrl + "lists/"} class="btn-secondary">
          View Saved Lists
        </a>
      </div>

      <!-- Add Item Form -->
      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-4">Add Item</h2>
        <form id="addItemForm" class="flex gap-3">
          <input
            type="text"
            id="itemInput"
            placeholder="Enter item name..."
            required
            class="input flex-1"
          />
          <button type="submit" class="btn-primary">Add</button>
        </form>
      </div>

      <!-- Shopping List -->
      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-4">Items</h2>
        <div id="itemsList" class="space-y-2">
          <p class="text-gray-500">
            No items yet. Add some items to get started!
          </p>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex gap-3">
        <button id="saveListBtn" class="btn-secondary flex-1">
          Save List
        </button>
        <button id="generateRouteBtn" class="btn-primary flex-1">
          Generate In-Store Route
        </button>
      </div>
    </div>

    <!-- Save List Modal -->
    <div
      id="saveModal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
    >
      <div class="card max-w-md w-full mx-4">
        <h2 class="text-2xl font-bold mb-4">Save Shopping List</h2>
        <form id="saveForm">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">
              List Name
            </label>
            <input
              type="text"
              id="listNameInput"
              placeholder="e.g., Weekly Groceries"
              required
              class="input"
            />
          </div>
          <div class="flex gap-3">
            <button type="button" id="cancelSave" class="btn-secondary flex-1">
              Cancel
            </button>
            <button type="submit" class="btn-primary flex-1"> Save </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script type="module" define:vars={{ baseUrl }}>
    const authUrl = baseUrl + "auth.js";

    import(authUrl).then(({ auth, saveShoppingList, getDoc, doc, db }) => {
      import("https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js").then(
        ({ onAuthStateChanged }) => {
          const form = document.getElementById("addItemForm");
          const itemInput = document.getElementById("itemInput");
          const itemsList = document.getElementById("itemsList");
          const generateRouteBtn = document.getElementById("generateRouteBtn");
          const saveListBtn = document.getElementById("saveListBtn");
          const saveModal = document.getElementById("saveModal");
          const saveForm = document.getElementById("saveForm");
          const cancelSave = document.getElementById("cancelSave");
          const listNameInput = document.getElementById("listNameInput");

          let items = [];
          let currentUser = null;

          onAuthStateChanged(auth, (user) => {
            if (!user) {
              window.location.href = baseUrl + "login/";
            } else {
              currentUser = user;
              checkForLoadList();
            }
          });

          async function checkForLoadList() {
            const urlParams = new URLSearchParams(window.location.search);
            const listId = urlParams.get("id");

            if (listId) {
              try {
                const docRef = doc(db, "shoppingLists", listId);
                const docSnap = await getDoc(docRef);

                if (docSnap.exists()) {
                  const listData = docSnap.data();
                  items = listData.items;
                  renderItems();
                }
              } catch (error) {
                console.error("Error loading list:", error);
              }
            }
          }

          function renderItems() {
            if (items.length === 0) {
              itemsList.innerHTML =
                '<p class="text-gray-500">No items yet. Add some items to get started!</p>';
              return;
            }

            itemsList.innerHTML = items
              .map(
                (item, index) => `
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
              <span class="text-lg">${item}</span>
              <button 
                onclick="removeItem(${index})" 
                class="text-red-600 hover:text-red-800 font-medium"
              >
                Remove
              </button>
            </div>
          `
              )
              .join("");
          }

          window.removeItem = function (index) {
            items.splice(index, 1);
            renderItems();
          };

          form.addEventListener("submit", (e) => {
            e.preventDefault();
            const itemName = itemInput.value.trim();

            if (itemName) {
              items.push(itemName);
              itemInput.value = "";
              renderItems();
            }
          });

          saveListBtn.addEventListener("click", () => {
            if (items.length === 0) {
              alert("Add some items first!");
              return;
            }
            saveModal.classList.remove("hidden");
          });

          cancelSave.addEventListener("click", () => {
            saveModal.classList.add("hidden");
            listNameInput.value = "";
          });

          saveForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const listName = listNameInput.value.trim();

            if (!listName) {
              alert("Please enter a list name");
              return;
            }

            try {
              await saveShoppingList(currentUser.uid, listName, items);
              alert("List saved successfully!");
              saveModal.classList.add("hidden");
              listNameInput.value = "";
              window.location.href = baseUrl + "lists/";
            } catch (error) {
              alert("Error saving list: " + error.message);
            }
          });

          generateRouteBtn.addEventListener("click", () => {
            if (items.length === 0) {
              alert("Add some items first!");
              return;
            }

            // TODO: Implement route generation logic
            alert(
              `Route generation coming soon! You have ${items.length} items.`
            );
          });
        }
      );
    });
  </script>
</BaseLayout>
