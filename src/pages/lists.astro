---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout>
  <Header />

  <main class="container py-12">
    <div class="max-w-4xl mx-auto">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Saved Lists</h1>
        <a href={baseUrl + "list/"} class="btn-primary"> Create New List </a>
      </div>

      <div id="listsContainer" class="space-y-4">
        <p class="text-gray-500">Loading...</p>
      </div>

      <!-- QR Code Modal -->
      <div
        id="qrModal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
      >
        <div class="card max-w-md w-full mx-4">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold">Share List</h2>
            <button
              id="closeModal"
              class="text-gray-500 hover:text-gray-700 text-2xl">×</button
            >
          </div>

          <div class="text-center">
            <div id="qrcode" class="flex justify-center mb-4"></div>
            <p class="text-sm text-gray-600 mb-2">Share Code:</p>
            <p id="shareCode" class="text-2xl font-mono font-bold mb-4"></p>
            <p class="text-sm text-gray-500">
              Others can scan this QR code or enter the share code to import
              this list
            </p>
          </div>
        </div>
      </div>

      <!-- Import List Section -->
      <div class="card mt-8">
        <h2 class="text-xl font-semibold mb-4">Import Shared List</h2>
        <form id="importForm" class="flex gap-3">
          <input
            type="text"
            id="importCode"
            placeholder="Enter share code..."
            required
            class="input flex-1"
          />
          <button type="submit" class="btn-primary">Import</button>
        </form>
      </div>
    </div>
  </main>

  <script type="module" define:vars={{ baseUrl }}>
    const authUrl = baseUrl + "auth.js";

    // Import QR Code library
    const qrScript = document.createElement("script");
    qrScript.src =
      "https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js";
    document.head.appendChild(qrScript);

    import(authUrl).then(
      ({
        auth,
        getUserLists,
        deleteShoppingList,
        getListByShareCode,
        saveShoppingList,
      }) => {
        import("https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js").then(
          ({ onAuthStateChanged }) => {
            const listsContainer = document.getElementById("listsContainer");
            const qrModal = document.getElementById("qrModal");
            const closeModal = document.getElementById("closeModal");
            const shareCodeEl = document.getElementById("shareCode");
            const qrcodeDiv = document.getElementById("qrcode");
            const importForm = document.getElementById("importForm");
            const importCode = document.getElementById("importCode");

            let currentUser = null;

            onAuthStateChanged(auth, async (user) => {
              if (!user) {
                window.location.href = baseUrl + "login/";
              } else {
                currentUser = user;
                await loadLists();
              }
            });

            async function loadLists() {
              try {
                const lists = await getUserLists(currentUser.uid);

                if (lists.length === 0) {
                  listsContainer.innerHTML =
                    '<p class="text-gray-500">No saved lists yet. Create your first list!</p>';
                  return;
                }

                listsContainer.innerHTML = lists
                  .map(
                    (list) => `
              <div class="card">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold mb-2">${list.listName}</h3>
                    <p class="text-gray-600 mb-2">${list.items.length} items</p>
                    <div class="flex flex-wrap gap-2">
                      ${list.items
                        .slice(0, 5)
                        .map(
                          (item) => `
                        <span class="px-2 py-1 bg-gray-100 rounded text-sm">${item}</span>
                      `
                        )
                        .join("")}
                      ${list.items.length > 5 ? `<span class="px-2 py-1 bg-gray-100 rounded text-sm">+${list.items.length - 5} more</span>` : ""}
                    </div>
                  </div>
                  <div class="flex gap-2 ml-4">
                    <button onclick="useList('${list.id}')" class="btn-primary">
                      Use
                    </button>
                    <button onclick="shareList('${list.id}', '${list.sharedCode}')" class="btn-secondary">
                      Share
                    </button>
                    <button onclick="deleteList('${list.id}')" class="text-red-600 hover:text-red-800 px-3">
                      Delete
                    </button>
                  </div>
                </div>
              </div>
            `
                  )
                  .join("");
              } catch (error) {
                console.error("Error loading lists:", error);
                listsContainer.innerHTML =
                  '<p class="text-red-500">Error loading lists. Please try again.</p>';
              }
            }

            window.useList = function (listId) {
              window.location.href = baseUrl + "list/?id=" + listId;
            };

            window.shareList = function (listId, sharedCode) {
              shareCodeEl.textContent = sharedCode;
              qrcodeDiv.innerHTML = "";

              // Wait for QRCode library to load
              const checkQR = setInterval(() => {
                if (typeof QRCode !== "undefined") {
                  clearInterval(checkQR);
                  new QRCode(qrcodeDiv, {
                    text:
                      window.location.origin +
                      baseUrl +
                      "import/?code=" +
                      sharedCode,
                    width: 200,
                    height: 200,
                  });
                }
              }, 100);

              qrModal.classList.remove("hidden");
            };

            window.deleteList = async function (listId) {
              if (confirm("Are you sure you want to delete this list?")) {
                try {
                  await deleteShoppingList(listId);
                  await loadLists();
                } catch (error) {
                  alert("Error deleting list: " + error.message);
                }
              }
            };

            closeModal.addEventListener("click", () => {
              qrModal.classList.add("hidden");
            });

            importForm.addEventListener("submit", async (e) => {
              e.preventDefault();
              const code = importCode.value.trim().toUpperCase();

              try {
                const sharedList = await getListByShareCode(code);

                if (!sharedList) {
                  alert("List not found. Please check the code and try again.");
                  return;
                }

                // Save as new list for current user
                await saveShoppingList(
                  currentUser.uid,
                  sharedList.listName + " (imported)",
                  sharedList.items
                );

                alert("List imported successfully!");
                importCode.value = "";
                await loadLists();
              } catch (error) {
                alert("Error importing list: " + error.message);
              }
            });
          }
        );
      }
    );
  </script>
</BaseLayout>
